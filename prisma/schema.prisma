generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  passwordHash    String?
  role            UserRole        @default(USER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sex             Sex?
  heightCm        Int?
  weightKg        Float?
  age             Int?
  bodyFat         BodyFat?
  activityLevel   ActivityLevel?
  dietForms       DietForm[]
  dietPreferences DietPreference?
  foodExclusions  FoodExclusion[]
  macroRanges     MacroRange?
  mealPreferences MealPreference?
  nutritionGoals  NutritionGoal?
  nutritionLimits NutritionLimit?
  userProgress    UserProgress[]

  @@map("users")
}

model DietPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  dietType        DietType
  measurementUnit MeasurementUnit @default(US_STANDARD)
  energyUnit      EnergyUnit      @default(CALORIES)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diet_preferences")
}

model FoodExclusion {
  id           String       @id @default(cuid())
  userId       String
  allergenType AllergenType
  customFood   String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("food_exclusions")
}

model DietExclusion {
  id           String   @id @default(cuid())
  dietType     DietType
  excludedFood String
  createdAt    DateTime @default(now())

  @@map("diet_exclusions")
}

model NutritionGoal {
  id           String   @id @default(cuid())
  userId       String   @unique
  goalType     GoalType
  goalMode     GoalMode @default(GENERAL)
  targetWeight Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_goals")
}

model MacroRange {
  id         String   @id @default(cuid())
  userId     String   @unique
  carbsMin   Int
  carbsMax   Int
  fatsMin    Int
  fatsMax    Int
  proteinMin Int
  proteinMax Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("macro_ranges")
}

model MealPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  breakfast      Boolean  @default(true)
  lunch          Boolean  @default(true)
  dinner         Boolean  @default(true)
  snack          Boolean  @default(true)
  favoriteDishes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meal_preferences")
}

model NutritionLimit {
  id               String   @id @default(cuid())
  userId           String   @unique
  minFiber         Int      @default(25)
  limitSodium      Boolean  @default(false)
  limitCholesterol Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_limits")
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weightKg  Float?
  bodyFat   BodyFat?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model DietForm {
  id          String    @id @default(cuid())
  userId      String
  dietType    DietType
  answers     String[]
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diet_forms")
}

enum UserRole {
  USER
  ADMIN
}

enum Sex {
  MALE
  FEMALE
  NON_BINARY
}

enum BodyFat {
  LOW
  MEDIUM
  HIGH
}

enum ActivityLevel {
  DESK_JOB
  LIGHTLY_ACTIVE
  ACTIVE
  VERY_ATHLETIC
  EXTREMELY_ATHLETIC
}

enum DietType {
  ANYTHING
  KETO
  MEDITERRANEAN
  PALEO
  VEGAN
  VEGETARIAN
  OMNIVORE
  FOUR_FED
}

enum MeasurementUnit {
  US_STANDARD
  METRIC
}

enum EnergyUnit {
  CALORIES
  KILOJOULES
}

enum AllergenType {
  DAIRY
  EGGS
  FISH
  GLUTEN
  TREE_NUTS
  PEANUTS
  SESAME
  SHELLFISH
  SOY
}

enum GoalType {
  LOSE_FAT
  MAINTAIN
  BUILD_MUSCLE
}

enum GoalMode {
  GENERAL
  EXACT
}

// ====== NEW MODELS FOR SOCIAL + ORDERING SYSTEM ======

model Vendor {
  id              String   @id @default(cuid())
  name            String?
  location        Json?
  leadTimeMinutes Int?
  capacity        Int?
  minOrderQty     Int      @default(1)
  updatedAt       DateTime @default(now())
  meals           Meal[]
  orders          Order[]

  @@map("vendors")
}

model Meal {
  id                  String   @id @default(cuid())
  vendorId            String?
  vendor              Vendor?  @relation(fields: [vendorId], references: [id])
  title               String?
  description         String?
  tags                String[]
  nutrition           Json?
  cost                Float?
  prepTimeMinutes     Int?
  portionSize         Int?
  sustainabilityScore Float?
  createdAt           DateTime @default(now())
  videos              Video[]

  @@map("meals")
}

model Video {
  id            String   @id @default(cuid())
  mealId        String?
  meal          Meal?    @relation(fields: [mealId], references: [id])
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id])
  s3Key         String?
  durationSeconds Int?
  thumbnailS3   String?
  createdAt     DateTime @default(now())
  metadata      Json     @default("{}")
  socialEvents  SocialEvent[]

  @@map("videos")
}

model SocialEvent {
  id           BigInt   @id @default(autoincrement())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id])
  eventType    String   // e.g., 'play', 'like', 'share', 'completion'
  eventPayload Json     @default("{}")
  createdAt    DateTime @default(now())

  @@map("social_events")
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id])
  total     Float
  status    String
  createdAt DateTime @default(now())
  metadata  Json?

  @@map("orders")
}

model Waitlist {
  id        String   @id @default(cuid())
  eventId   String?  // optional: could reference an external event (e.g., video or meal launch)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  recType   String   // e.g., 'meal', 'video', 'bundle'
  items     Json     // array of recommended item IDs or full objects
  context   Json     // e.g., { "source": "video", "videoId": "..." }
  createdAt DateTime @default(now())

  @@map("recommendations")
}
